# ===== DBAuto 环境变量示例 =====
# 复制为 .env 并按需修改；切勿将真实密钥提交到仓库。
#
# 说明：以下变量仅在「首次启动」时作为初始值写入 DATA_DIR/config.json，
#       之后以配置文件为准。推荐启动后在设置页面（⚙️）配置。

# 服务端口
PORT=3001

# 数据持久化目录（容器内默认 /data/douban-history；挂载为 volume 以保证持久化）
DATA_DIR=/data/douban-history

# 时区（用于调度与日志时间显示）
TZ=Asia/Shanghai

# 登录用户名（首次初始值）
AUTH_USER=root

# 登录密码（首次初始值；启动后以 PBKDF2(600000) 哈希存储于 config.json）
AUTH_PASS=change_me

# 是否信任反向代理发送的请求头（X-Forwarded-For / X-Real-IP / X-Forwarded-Proto）。
# 仅在部署于可信反代（Nginx / Cloudflare Tunnel 等）之后才置 true；
# 否则攻击者可伪造 XFF 绕过 IP 限速 / 审计。
TRUST_PROXY=false

# 以下为可选服务地址（首次初始值，也可在设置页面填写）
PANSOU=http://192.168.1.1:8080
QAS=http://192.168.1.1:5005
QAS_TOKEN=
DOUBAN_UID=
DOUBAN_COOKIE=
TMDB_API_KEY=
TMDB_BASE_URL=
TMDB_PROXY=

# 加密密钥说明：敏感字段（qas_token / auth_pass / douban_cookie）使用 Fernet 加密，
# 密钥派生自 DATA_DIR/.salt 文件（首次启动自动随机生成，权限 0600）。
# 该密钥【不是】环境变量，请务必持久化并备份 DATA_DIR/.salt，
# 否则重装 / 更换挂载后将无法解密已有敏感字段。
